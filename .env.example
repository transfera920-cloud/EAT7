# Google Maps Platform API Key (Server-side key for Geocoding, Places API (New), Routes API, and Maps JS API)
GOOGLE_MAPS_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default 3000)
PORT=3000

# Session Secret for Admin Authentication
SESSION_SECRET="mountain-feast-secure-session-key"

# SQLite Database File Path
DATABASE_PATH="./data/mountain_feast.db"
